import os
from flask import Flask
from threading import Thread
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, ContextTypes, filters

# --- KEEP ALIVE FOR 24/7 ---
app_flask = Flask('')

@app_flask.route('/')
def home():
    return "GHOST is alive 24/7"

def run():
    app_flask.run(host='0.0.0.0', port=8080)

def keep_alive():
    t = Thread(target=run)
    t.start()

# --- YOUR BOT CONFIG ---
BOT_TOKEN = os.environ.get("BOT_TOKEN")
OWNER_ID = 6801081064

LEARN_LINK = "https://t.me/crystalloungbot"
BROKER_LINK = "https://broker-qx.pro/sign-up/?lid=2371883"
CHANNEL_LINK = "https://t.me/crystallounge37"

user_map = {}

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id == OWNER_ID:
        await update.message.reply_text("Owner mode active ✅\nReply to any forwarded message to answer client.")
        return

    name = update.effective_user.first_name
    keyboard = [
        [InlineKeyboardButton("📲 Open Broker", url=BROKER_LINK)],
        [InlineKeyboardButton("📚 Learn Trading", url=LEARN_LINK)],
        [InlineKeyboardButton("📢 Join Channel", url=CHANNEL_LINK)]
    ]
    markup = InlineKeyboardMarkup(keyboard)
    
    await update.message.reply_text(
        f"Hello, {name}. I am ✦𝗚𝗛𝗢𝗦𝗧✦ 🚀\n\n"
        f"Welcome to Crystal Lounge!\n\n"
        f"Tap below to get started 👇",
        reply_markup=markup
    )

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    text = update.message.text
    if text is None:
        text = ""

    if user.id == OWNER_ID:
        if update.message.reply_to_message:
            replied_id = update.message.reply_to_message.message_id
            if replied_id in user_map:
                target_id = user_map[replied_id]
                try:
                    await context.bot.send_message(chat_id=target_id, text=f"✦𝗚𝗛𝗢𝗦𝗧✦ replied:\n\n{text}")
                    await update.message.reply_text(f"✅ Sent to {target_id}")
                except Exception as e:
                    await update.message.reply_text(f"❌ Failed: {e}")
            else:
                await update.message.reply_text("❌ Reply to the forwarded message I sent you.")
        else:
            await update.message.reply_text("To answer a client, reply to the forwarded message.")
        return

    name = user.first_name
    username = f"@{user.username}" if user.username else "No username"

    sent = await context.bot.send_message(
        chat_id=OWNER_ID,
        text=f"📩 New from {name} {username} (ID: {user.id}):\n\n{text}"
    )
    user_map[sent.message_id] = user.id

    keyboard = [
        [InlineKeyboardButton("📲 Open Broker", url=BROKER_LINK)],
        [InlineKeyboardButton("📚 Learn Trading", url=LEARN_LINK)],
        [InlineKeyboardButton("📢 Join @crystallounge37", url=CHANNEL_LINK)]
    ]
    markup = InlineKeyboardMarkup(keyboard)

    await update.message.reply_text(
        f"Got it, {name} ✅\n\nI received your message.\nCheck these out 👇",
        reply_markup=markup
    )

# --- RUN ---
keep_alive()
app = ApplicationBuilder().token(BOT_TOKEN).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))

print("✦𝗚𝗛𝗢𝗦𝗧✦ 24/7 is running...")
app.run_polling()
